yber • truvocyber.com" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#888888;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="985" width="1620" height="30" as="geometry" /></mxCell><mxCell id="n1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#444444;strokeColor=#ef6c00;strokeWidth=2;startArrow=oval;startFill=1;startSize=7;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c30" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#444444;strokeColor=#ef6c00;strokeWidth=1.25;endArrow=block;endFill=1;endSize=5;flowAnimation=1;exitX=1;exitY=0.243;entryX=0;entryY=0.2;" edge="1" parent="1" source="c19" target="c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#444444;strokeColor=#ef6c00;strokeWidth=1.25;endArrow=block;endFill=1;endSize=5;flowAnimation=1;exitX=0;exitY=0.8;entryX=1;entryY=0.757;" edge="1" parent="1" source="c30" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;WSS 443&lt;/b&gt;&lt;br&gt;Socket Mode,&lt;br&gt;opened from the VM" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="288" y="306" width="102" height="44" as="geometry" /></mxCell><mxCell id="L1" value="Fill colour = zone type" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;fontColor=#444444;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1252" y="660" width="180" height="16" as="geometry" /></mxCell><mxCell id="L2" value="Line