<mxfile><diagram id="oc-settings" name="OpenClaw security settings map"><mxGraphModel dx="1400" dy="950" grid="0" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1030" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c11" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="120" height="35" as="geometry" /></mxCell><mxCell id="c12" value="truvocyber.com" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=9;fontColor=#888888;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="160" height="16" as="geometry" /></mxCell><mxCell id="c13" value="Where the 10 OpenClaw Security Settings Apply - Self-Hosted Agent on a Mac" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=22;fontColor=#0066cc;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="1000" height="30" as="geometry" /></mxCell><mxCell id="c14" value="Each green number marks the component a setting protects. Tested in the Truvo OpenClaw lab, October 2026, OpenClaw 2026.10.7." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=12;fontColor=#666666;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="330" y="54" width="1000" height="20" as="geometry" /></mxCell><mxCell id="c15" value="Reference design • Truvo Cyber" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=9;fontColor=#888888;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1330" y="26" width="330" height="30" as="geometry" /></mxCell><mxCell id="c16" value="User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565c0;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#1565c0;arcSize=3;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="230" height="130" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;Slack, desktop or phone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.5;fontSize=12;fontColor=#333333;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="150" width="180" height="60" as="geometry" /></mxCell><mxCell id="c18" value="Slack (SaaS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c62828;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#c62828;arcSize=3;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="230" height="150" as="geometry" /></mxCell><mxCell id="c19" value="&lt;b&gt;Slack workspace&lt;/b&gt;&lt;br&gt;dedicated bot app&lt;br&gt;DMs only, Socket Mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;strokeWidth=1.5;fontSize=12;fontColor=#b71c1c;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="345" width="180" height="70" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b&gt;Slack controls&lt;/b&gt;&lt;br&gt;✓ Socket Mode: no public webhook URL&lt;br&gt;✓ DM allowlist of named users&lt;br&gt;✓ No channel, group DM or file scopes&lt;br&gt;✓ Minimum bot scopes from a manifest&lt;br&gt;✓ Tokens typed straight into the secret store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6f9;strokeWidth=1;fontSize=10;fontColor=#555555;align=left;spacingLeft=8;arcSize=8;verticalAlign=top;spacingTop=4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="230" height="92" as="geometry" /></mxCell><mxCell id="c21" value="Admin access (local)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5e35b1;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#5e35b1;arcSize=3;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="230" height="200" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;Administrator at the Mac&lt;/b&gt;&lt;br&gt;local console" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;strokeWidth=1.5;fontSize=12;fontColor=#311b92;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="635" width="180" height="50" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;Lume (VM manager)&lt;/b&gt;&lt;br&gt;SSH (key) • clone • stop&lt;br&gt;VNC: Mac only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;strokeWidth=1.5;fontSize=12;fontColor=#311b92;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="725" width="180" height="50" as="geometry" /></mxCell><mxCell id="c25" value="Mac host • no inbound ports • macOS firewall on, stealth mode, Lume blocked inbound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565c0;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#1565c0;arcSize=3;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="560" height="600" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b&gt;OpenClaw secret store&lt;/b&gt;&lt;br&gt;Slack tokens, gateway token&lt;br&gt;(write-only to the agent)&lt;br&gt;Vertex SA key file, owner-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00695c;strokeWidth=1.5;fontSize=11;fontColor=#004d40;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="170" height="64" as="geometry" /></mxCell><mxCell id="c27" value="&lt;b&gt;OpenClaw logs&lt;/b&gt;&lt;br&gt;gateway + tool calls,&lt;br&gt;reviewed weekly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00695c;strokeWidth=1.5;fontSize=11;fontColor=#004d40;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="635" y="150" width="160" height="64" as="geometry" /></mxCell><mxCell id="c28" value="&lt;b&gt;Lume clones&lt;/b&gt;&lt;br&gt;clean baseline +&lt;br&gt;last known good config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontSize=11;fontColor=#1b5e20;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="150" width="160" height="64" as="geometry" /></mxCell><mxCell id="c29" value="Lume macOS VM • dedicated disk • no shared folders, clipboard or personal accounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ef6c00;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#ef6c00;arcSize=3;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="450" y="280" width="525" height="410" as="geometry" /></mxCell><mxCell id="c30" value="&lt;b&gt;OpenClaw gateway&lt;/b&gt;&lt;br&gt;bound to localhost • Bonjour off&lt;br&gt;LaunchAgent, starts at login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=1.5;fontSize=11;fontColor=#e65100;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="350" width="200" height="60" as="geometry" /></mxCell><mxCell id="c31" value="&lt;b&gt;OpenClaw agent&lt;/b&gt;&lt;br&gt;messaging tools only&lt;br&gt;no shell, files or web&lt;br&gt;code mode off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=1.5;fontSize=11;fontColor=#e65100;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="440" width="200" height="72" as="geometry" /></mxCell><mxCell id="c32" value="&lt;b&gt;OpenClaw Vertex provider&lt;/b&gt;&lt;br&gt;default model + fallback&lt;br&gt;service-account key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=1.5;fontSize=11;fontColor=#e65100;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="220" height="72" as="geometry" /></mxCell><mxCell id="c33" value="&lt;b&gt;OpenClaw state&lt;/b&gt;&lt;br&gt;config • sessions • memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontSize=11;fontColor=#1b5e20;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="545" width="200" height="70" as="geometry" /></mxCell><mxCell id="c34" value="&lt;b&gt;Config in version control&lt;/b&gt;&lt;br&gt;tool allow/deny lists&lt;br&gt;per agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontSize=11;fontColor=#1b5e20;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="545" width="220" height="70" as="geometry" /></mxCell><mxCell id="c35" value="Google Cloud: Vertex AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c62828;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#c62828;arcSize=3;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1010" y="280" width="210" height="410" as="geometry" /></mxCell><mxCell id="c36" value="&lt;b&gt;Low-cost model&lt;/b&gt;&lt;br&gt;e.g. Gemini Flash-Lite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;strokeWidth=1.5;fontSize=11;fontColor=#b71c1c;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1025" y="320" width="180" height="50" as="geometry" /></mxCell><mxCell id="c37" value="&lt;b&gt;Stronger model&lt;/b&gt;&lt;br&gt;e.g. Claude on Vertex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=1.5;fontSize=11;fontColor=#616161;arcSize=12;verticalAlign=middle;dashed=1;dashPattern=1 4;" vertex="1" parent="1"><mxGeometry x="1025" y="385" width="180" height="50" as="geometry" /></mxCell><mxCell id="c38" value="&lt;b&gt;Image, voice, search&lt;/b&gt;&lt;br&gt;needs a Gemini API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=1.5;fontSize=11;fontColor=#616161;arcSize=12;verticalAlign=middle;dashed=1;dashPattern=1 4;" vertex="1" parent="1"><mxGeometry x="1025" y="450" width="180" height="50" as="geometry" /></mxCell><mxCell id="c39" value="&lt;b&gt;Hard spend cap&lt;/b&gt;&lt;br&gt;on Vertex AI&lt;br&gt;alerts at 50/80/100%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00695c;strokeWidth=1.5;fontSize=11;fontColor=#004d40;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1025" y="520" width="180" height="50" as="geometry" /></mxCell><mxCell id="c40" value="Dedicated Google Cloud project. The service account holds one role: Vertex AI User. Check that the cap covers Marketplace-billed models." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=9;fontColor=#888888;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1025" y="585" width="180" height="60" as="geometry" /></mxCell><mxCell id="c41" value="Business data sources (add later)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9e9e9e;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#9e9e9e;arcSize=3;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1240" y="110" width="420" height="250" as="geometry" /></mxCell><mxCell id="c42" value="&lt;b&gt;Calendar&lt;/b&gt;  read-only, agent's own account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=1.5;fontSize=11;fontColor=#616161;arcSize=12;verticalAlign=middle;dashed=1;dashPattern=1 4;" vertex="1" parent="1"><mxGeometry x="1265" y="150" width="370" height="40" as="geometry" /></mxCell><mxCell id="c43" value="&lt;b&gt;Email&lt;/b&gt;  read-only, agent's own account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=1.5;fontSize=11;fontColor=#616161;arcSize=12;verticalAlign=middle;dashed=1;dashPattern=1 4;" vertex="1" parent="1"><mxGeometry x="1265" y="205" width="370" height="40" as="geometry" /></mxCell><mxCell id="c44" value="&lt;b&gt;CRM&lt;/b&gt;  read-only API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=1.5;fontSize=11;fontColor=#616161;arcSize=12;verticalAlign=middle;dashed=1;dashPattern=1 4;" vertex="1" parent="1"><mxGeometry x="1265" y="260" width="370" height="40" as="geometry" /></mxCell><mxCell id="c45" value="The agent gets its own credentials, never a person's login session." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;fontColor=#888888;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1265" y="310" width="370" height="20" as="geometry" /></mxCell><mxCell id="c46" value="Growing it: one agent per job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9e9e9e;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#9e9e9e;arcSize=3;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1240" y="390" width="420" height="220" as="geometry" /></mxCell><mxCell id="c47" value="&lt;b&gt;Capture agent&lt;/b&gt;  own Slack app → task tracker (write, one project)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=1.5;fontSize=11;fontColor=#616161;arcSize=12;verticalAlign=middle;dashed=1;dashPattern=1 4;" vertex="1" parent="1"><mxGeometry x="1265" y="430" width="370" height="38" as="geometry" /></mxCell><mxCell id="c48" value="&lt;b&gt;Repo agent&lt;/b&gt;  one repo, scoped token, pull requests only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=1.5;fontSize=11;fontColor=#616161;arcSize=12;verticalAlign=middle;dashed=1;dashPattern=1 4;" vertex="1" parent="1"><mxGeometry x="1265" y="480" width="370" height="38" as="geometry" /></mxCell><mxCell id="c49" value="&lt;b&gt;Hosting&lt;/b&gt;  move to a Google Cloud VM with no public IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;strokeWidth=1.5;fontSize=11;fontColor=#616161;arcSize=12;verticalAlign=middle;dashed=1;dashPattern=1 4;" vertex="1" parent="1"><mxGeometry x="1265" y="530" width="370" height="38" as="geometry" /></mxCell><mxCell id="c50" value="Rule: web access and private data never share one agent" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;fontColor=#888888;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1265" y="578" width="370" height="20" as="geometry" /></mxCell><mxCell id="c51" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#444444;strokeColor=#e53935;strokeWidth=2;startArrow=oval;startFill=1;startSize=7;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#444444;strokeColor=#2e7d32;strokeWidth=1.5;flowAnimation=1;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c55" value="model call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#444444;strokeColor=#2e7d32;strokeWidth=1.5;flowAnimation=1;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c56" value="HTTPS out&lt;br&gt;service account" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgrou