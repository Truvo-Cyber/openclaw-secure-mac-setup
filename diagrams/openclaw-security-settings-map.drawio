.5;dashed=1;dashPattern=6 3;exitY=0;entryX=0.5;entryY=1;exitX=0.838;" edge="1" parent="1" source="c29" target="c28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c62" value="add later" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#444444;strokeWidth=1.5;exitX=0.97;exitY=0;entryX=0;entryY=0.5;dashed=1;dashPattern=1 4;strokeColor=#9e9e9e;" edge="1" parent="1" source="c29" target="c44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="262" /><mxPoint x="1228" y="262" /><mxPoint x="1228" y="280" /></Array></mxGeometry></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#444444;strokeColor=#5e35b1;strokeWidth=1.5;flowAnimation=1;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#444444;strokeColor=#5e35b1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.878;startArrow=oval;startFill=1;startSize=7;" edge="1" parent="1" source="c23" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="285" y="750" /><mxPoint x="285" y="640" /></Array></mxGeometry></mxCell><mxCell id="c72" value="&lt;b&gt;Host controls&lt;/b&gt;&lt;br&gt;✓ macOS firewall on, stealth mode, auto-allow off&lt;br&gt;✓ Lume blocked inbound: VNC from this Mac only&lt;br&gt;✓ VM SSH: key only, one user, from the host only&lt;br&gt;✓ No inbound ports; every connection starts from the VM&lt;br&gt;✓ Kill switch: lume stop, revoke SA key + Slack app, restore clone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3fbfa;strokeWidth=1;fontColor=#555555;align=left;spacingLeft=8;arcSize=8;verticalAlign=top;spacingTop=4;fontSize=11;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="728" width="470" height="112" as="geometry" /></mxCell><mxCell id="c73" value="&lt;b&gt;OpenClaw controls&lt;/b&gt;&lt;br&gt;✓ No ClawHub skills without review&lt;br&gt;✓ Deny groups: runtime, fs, web, ui, nodes, automation&lt;br&gt;✓ Code mode off (it can expose exec with runtime denied)&lt;br&gt;✓ Re-check the tool list in a fresh session after each update&lt;br&gt;✓ Spend cap on every model service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3fbfa;strokeWidth=1;fontColor=#555555;align=left;spacingLeft=8;arcSize=8;verticalAlign=top;spacingTop=4;fontSize=11;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="790" y="728" width="430" height="112" as="geometry" /></mxCell><mxCell id="c74" value="&lt;b&gt;OpenClaw security settings 1 to 5&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;1&lt;/font&gt;&lt;/b&gt;&amp;nbsp; Run OpenClaw in a Lume macOS VM, no shared folders&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;2&lt;/font&gt;&lt;/b&gt;&amp;nbsp; Agent-owned service account, one role: Vertex AI User&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;3&lt;/font&gt;&lt;/b&gt;&amp;nbsp; Hard spend cap on Vertex AI&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;4&lt;/font&gt;&lt;/b&gt;&amp;nbsp; Messaging tool profile, shell, file and web groups denied&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;5&lt;/font&gt;&lt;/b&gt;&amp;nbsp; Code mode off: tools.codeMode.enabled false" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#444444;fontStyle=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="858" width="560" height="118" as="geometry" /></mxCell><mxCell id="c75" value="&lt;b&gt;OpenClaw security settings 6 to 10&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;6&lt;/font&gt;&lt;/b&gt;&amp;nbsp; Gateway on loopback with token auth&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;7&lt;/font&gt;&lt;/b&gt;&amp;nbsp; Bonjour and mDNS discovery off&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;8&lt;/font&gt;&lt;/b&gt;&amp;nbsp; Slack DM-only app, Socket Mode, allowlist of named users&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;9&lt;/font&gt;&lt;/b&gt;&amp;nbsp; Slack and gateway tokens typed into the OpenClaw secret store&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;10&lt;/font&gt;&lt;/b&gt;&amp;nbsp; macOS firewall on, Lume blocked inbound, key-only SSH from the Mac" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#444444;fontStyle=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="858" width="600" height="118" as="geometry" /></mxCell><mxCell id="c76" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;arcSize=4;strokeColor=none;fillColor=#f7f8fa;" vertex="1" parent="1"><mxGeometry x="1240" y="630" width="420" height="350" as="geometry" /></mxCell><mxCell id="c77" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1252" y="638" width="200" height="18" as="geometry" /></mxCell><mxCell id="c78" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1254" y="682" width="24" height="14" as="geometry" /></mxCell><mxCell id="c79" value="User / local hardware" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1286" y="680" width="180" height="18" as="geometry" /></mxCell><mxCell id="c80" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e53935;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1254" y="702" widt